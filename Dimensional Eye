local Kill = true
local eye = game:GetObjects("rbxassetid://121926329858945")[1]
eye.Parent = game.Workspace
local eyes = eye:FindFirstChildWhichIsA("BasePart") or eye:FindFirstChildWhichIsA("Part")
eyes.CFrame = game.Workspace.CurrentRooms:GetChildren()[#game.Workspace.CurrentRooms:GetChildren() - 1].Parts.Floor.CFrame + Vector3.new(0,8,0)

wait(1.5)
task.spawn(function()
    while Kill == true do
        task.wait(0.01)
        local _ , camera = game.Workspace.CurrentCamera:WorldToViewportPoint(eyes.Position)
        if camera then
                game.Players.LocalPlayer.Character.Humanoid:TakeDamage(0.1)
        end
    if game.Players.LocalPlayer.Character.Humanoid.Health <= 0 then
                game.ReplicatedStorage.GameStats["Player_".. game.Players.LocalPlayer.Name].Total.DeathCause.Value = "Dimensional Eye"
    end
   end
end)
game.ReplicatedStorage.GameData.LatestRoom.Changed:Wait()
Kill = false
eye:Destroy()

